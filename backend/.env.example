# Copy this to .env — never commit .env to git

CUPRA_USERNAME=your.email@example.com
CUPRA_PASSWORD=your_cupra_password
CUPRA_VIN=VSSZZZ...          # 17-char VIN — car docs, MyCupra app, or door jamb sticker

# Shared secret — same value goes in Garmin Connect widget settings under "Api Key"
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=replace_me_with_a_random_string

CACHE_TTL=300    # seconds between Cupra API calls (default 5 min)
PORT=5000
# BIND_HOST=0.0.0.0   # change to 127.0.0.1 to restrict to localhost only
